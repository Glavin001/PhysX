+// Only the neighbour-read residual is shared. All dynamic endpoints of a
+// live bond belong to the owning component; prescribed static boundaries may
+// be outside it and retain their original global value. Stable inverse order
+// avoids a search in every sparse operator application. The same mathematical
+// bodies also accept ordinary global pointers for cooperative/reference work.
+struct ComponentResidualView
+{
+    AngLin* global;
+    float* local;
+    const unsigned* position;
+    unsigned begin, count;
+    __device__ __forceinline__ AngLin operator[](unsigned node) const
+    {
+        const unsigned i=position[node]-begin;
+        if(i>=count)return global[node];
+        constexpr unsigned stride=kResidentComponentMaxNodes;
+        return {{local[i],local[stride+i],local[2*stride+i],local[3*stride+i]},
+                {local[4*stride+i],local[5*stride+i],local[6*stride+i],local[7*stride+i]}};
+    }
+    __device__ __forceinline__ void store(unsigned node,AngLin value) const
+    {
+        const unsigned i=position[node]-begin;
+        if(i>=count){global[node]=value;return;}
+        constexpr unsigned stride=kResidentComponentMaxNodes;
+        local[i]=value.angular.x;local[stride+i]=value.angular.y;
+        local[2*stride+i]=value.angular.z;local[3*stride+i]=value.angular.w;
+        local[4*stride+i]=value.linear.x;local[5*stride+i]=value.linear.y;
+        local[6*stride+i]=value.linear.z;local[7*stride+i]=value.linear.w;
+    }
+};
+
