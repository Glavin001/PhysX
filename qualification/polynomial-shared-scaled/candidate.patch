+// A single cached vector fits without reducing the baseline's register-limited
+// two-block residency. Coordinates are separate shared arrays to keep adjacent
+// lanes' scalar accesses contiguous. Larger components retain the global view.
+constexpr unsigned kPolynomialSharedNodes=512;
+struct NativePolynomialSharedView {
+    const double* values;
+    const unsigned* ordinals;
+    __device__ __forceinline__ StressHierarchy::Vector local(unsigned i)const {
+        return {{values[i],values[kPolynomialSharedNodes+i],values[2*kPolynomialSharedNodes+i]},
+                {values[3*kPolynomialSharedNodes+i],values[4*kPolynomialSharedNodes+i],values[5*kPolynomialSharedNodes+i]}};
+    }
+    __device__ __forceinline__ bool scaled(const StressHierarchy::Input&,unsigned,unsigned,bool,
+        unsigned slot,StressHierarchy::Vector& value)const {
+        const unsigned i=ordinals[slot];if(i==StressHierarchy::Invalid)return false;
+        value=local(i);return true;
+    }
+};
+__device__ __forceinline__ StressHierarchy::Vector* preconditionNativePolynomialShared(
+    const PersistentStressArgs& a,const unsigned* nodes,unsigned count) {
+    using namespace StressHierarchy;
+    __shared__ double cache[6*kPolynomialSharedNodes];
+    constexpr double lowWeight=0.5779388123770052,highWeight=2.6335678180143502;
+    constexpr double coupling=lowWeight*highWeight,diagonal=lowWeight+highWeight-coupling;
+    const auto input=a.hierarchy.cycle.levels[0].input;
+    const NativePolynomialSharedView local{cache,a.hierarchy.referenceOrdinals};
+    auto* result=a.hierarchy.cycle.intermediate;
+    // Keep each lane's unscaled diagonal contribution in registers. Cache its
+    // scaled value once, so every neighboring gather avoids endpoint/inertia
+    // lookups and repeated scaling. The topology producer supplies CSR ordinals.
+    constexpr unsigned rows=(kPolynomialSharedNodes+kBlockSize-1)/kBlockSize;
+    Vector owned[rows];
+#pragma unroll
+    for(unsigned part=0;part<rows;++part){const unsigned i=threadIdx.x+part*kBlockSize;if(i>=count)continue;
+        const unsigned node=nodes[i];owned[part]=applyNativeFineInverse(a.hierarchy,node,a.hierarchy.rhs[node]);
+        const auto value=scaledValue(owned[part],input.inertia[node]);
+        cache[i]=value.angular.x;cache[kPolynomialSharedNodes+i]=value.angular.y;cache[2*kPolynomialSharedNodes+i]=value.angular.z;
+        cache[3*kPolynomialSharedNodes+i]=value.linear.x;cache[4*kPolynomialSharedNodes+i]=value.linear.y;cache[5*kPolynomialSharedNodes+i]=value.linear.z;}
+    __syncthreads();
+#pragma unroll
+    for(unsigned part=0;part<rows;++part){const unsigned i=threadIdx.x+part*kBlockSize;if(i>=count)continue;
+        const unsigned node=nodes[i];const auto off=nativeOffDiagonal(input,node,local);
+        result[node]=sub(mul(owned[part],diagonal),mul(applyNativeFineInverse(a.hierarchy,node,off),coupling));}
+    __syncthreads();return result;
+}
+__device__ __forceinline__ StressHierarchy::Vector* preconditionNativePolynomial(
+    const PersistentStressArgs& a,const unsigned* nodes,unsigned count) {
+    return count<=kPolynomialSharedNodes?preconditionNativePolynomialShared(a,nodes,count):preconditionNativePolynomialGlobal(a,nodes,count);
+}
