+    Device<E::Matrix> diagonal(isolated.x.size()),factors(isolated.x.size());
+    E::buildDiagonal<<<1,128>>>(disconnected.graph,diagonal.p,factors.p,disconnected.limits,disconnected.error.p,disconnected.numerical.p);
