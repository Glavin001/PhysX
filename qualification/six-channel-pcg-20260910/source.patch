+        moment[0]+=p.y*gradient[6*i+2]-p.z*gradient[6*i+1];moment[1]+=p.z*gradient[6*i]-p.x*gradient[6*i+2];moment[2]+=p.x*gradient[6*i+1]-p.y*gradient[6*i];}
