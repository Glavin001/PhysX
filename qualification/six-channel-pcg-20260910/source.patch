+        for(const auto& b:f.bonds)if(b.live){const auto g=f.G(b);for(unsigned u=0;u<6;++u)for(unsigned v=0;v<6;++v)expected[i]+=g[u*n+i]*b.stiffness.v[6*u+v]*b.inelastic.v[v];}
