+        if(b.live)for(unsigned row=0;row<6;++row){deformation[row]=-b.inelastic.v[row];for(unsigned j=0;j<n;++j)deformation[row]+=g[row*n+j]*(f.fixed[j/6]?f.prescribed[j/6].v[j%6]:q[j/6].v[j%6]);}
