+    f=Fixture{};f.bonds[0].point[0]=NAN;reject(f,E::InvalidValue);
+    f=Fixture{};f.refs[0]=999;reject(f,E::InvalidGraph);
+    f=Fixture{};f.refs[1]=f.refs[0];reject(f,E::InvalidGraph);
