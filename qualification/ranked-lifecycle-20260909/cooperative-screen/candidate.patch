+// Required cooperative residency is established during scene setup. A failed
+// qualification is explicit; there is no host-selection or unrolled fallback.
+inline cudaError_t nativeMotionSlotBlocks(PxU32 capacity,int& blocks) {
+    int device=0,major=0,minor=0,cooperative=0,sms=0,resident=0;
+    cudaError_t e=cudaGetDevice(&device);if(e!=cudaSuccess)return e;
+    e=cudaDeviceGetAttribute(&major,cudaDevAttrComputeCapabilityMajor,device);if(e!=cudaSuccess)return e;
+    e=cudaDeviceGetAttribute(&minor,cudaDevAttrComputeCapabilityMinor,device);if(e!=cudaSuccess)return e;
+    e=cudaDeviceGetAttribute(&cooperative,cudaDevAttrCooperativeLaunch,device);if(e!=cudaSuccess)return e;
+    if(major!=8 || minor!=9 || !cooperative)return cudaErrorNotSupported;
+    e=cudaDeviceGetAttribute(&sms,cudaDevAttrMultiProcessorCount,device);if(e!=cudaSuccess)return e;
+    e=cudaOccupancyMaxActiveBlocksPerMultiprocessor(&resident,allocateNativeMotionSlots,128,0);
+    if(e!=cudaSuccess)return e;
+    const PxU32 wanted=capacity/128+(capacity%128!=0);
+    blocks=int(wanted<PxU32(sms*resident)?wanted:PxU32(sms*resident));
+    if(!blocks)blocks=1;
+    return resident?cudaSuccess:cudaErrorNotSupported;
 }
