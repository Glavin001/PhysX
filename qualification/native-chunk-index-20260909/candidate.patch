diff --git a/physx/source/gpudestruction/src/PxgDestructionChunkIndex.cuh b/physx/source/gpudestruction/src/PxgDestructionChunkIndex.cuh
new file mode 100644
index 00000000..4dbf045a
--- /dev/null
+++ b/physx/source/gpudestruction/src/PxgDestructionChunkIndex.cuh
@@ -0,0 +1,58 @@
+// Copyright (c) 2026. SPDX-License-Identifier: BSD-3-Clause
+#pragma once
+#include "foundation/PxSimpleTypes.h"
+#include <algorithm>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+
+namespace physx { namespace destructionChunkIndex {
+// Immutable shape identities are independent of mutable rigid ownership. This
+// index is installed with the asset coupling and survives every cluster split.
+// Two indexed reads replace a scene-wide binary search for each contact endpoint.
+// Pages keep holes in PhysX's shape-ID domain from allocating a full chunk table.
+constexpr PxU32 pageBits=10;
+constexpr PxU32 pageSize=1u<<pageBits;
+constexpr PxU32 invalid=~PxU32(0);
+struct Entry { PxU32 contact,chunk; };
+struct View {
+    const PxU32* entries;
+    PxU32 firstPage,pageCount;
+    __device__ PxU32 find(PxU32 contact) const {
+        const PxU32 page=contact>>pageBits;
+        if(contact==invalid || page<firstPage || page-firstPage>=pageCount)return invalid;
+        const PxU32 offset=entries[page-firstPage];
+        return offset==invalid ? invalid : entries[offset+(contact&(pageSize-1))];
+    }
+};
+struct Storage {
+    std::vector<PxU32> entries;
+    PxU32 firstPage=0,pageCount=0;
+};
+// Asset installation only; no host work or copies are needed during simulation.
+// The directory spans at most 2^22 words even for the full 32-bit shape domain.
+inline Storage build(const std::vector<Entry>& sorted) {
+    Storage out;
+    if(sorted.empty())return out;
+    for(size_t i=0;i<sorted.size();++i)
+        if(sorted[i].contact==invalid || sorted[i].chunk==invalid
+            || (i && sorted[i-1].contact>=sorted[i].contact))
+            throw std::invalid_argument("invalid or duplicate destruction shape identity");
+    out.firstPage=sorted.front().contact>>pageBits;
+    out.pageCount=(sorted.back().contact>>pageBits)-out.firstPage+1;
+    out.entries.assign(out.pageCount,invalid);
+    for(const Entry& e:sorted) {
+        const PxU32 page=(e.contact>>pageBits)-out.firstPage;
+        PxU32 offset=out.entries[page];
+        if(offset==invalid) {
+            if(out.entries.size()>size_t(invalid)-pageSize)
+                throw std::length_error("destruction shape index capacity exceeded");
+            offset=PxU32(out.entries.size());
+            out.entries.resize(out.entries.size()+pageSize,invalid);
+            out.entries[page]=offset;
+        }
+        out.entries[offset+(e.contact&(pageSize-1))]=e.chunk;
+    }
+    return out;
+}
+}} // namespace physx::destructionChunkIndex
diff --git a/physx/source/gpudestruction/tests/chunk_index_test.cu b/physx/source/gpudestruction/tests/chunk_index_test.cu
new file mode 100644
index 00000000..cb6cdd80
--- /dev/null
+++ b/physx/source/gpudestruction/tests/chunk_index_test.cu
@@ -0,0 +1,61 @@
+// Copyright (c) 2026. SPDX-License-Identifier: BSD-3-Clause
+#include <cuda_runtime.h>
+#include "../src/PxgDestructionChunkIndex.cuh"
+#include <cstdio>
+#include <map>
+#include <random>
+using namespace physx;
+using namespace destructionChunkIndex;
+void check(cudaError_t e) { if(e!=cudaSuccess)throw std::runtime_error(cudaGetErrorString(e)); }
+void require(bool ok,const char* message) { if(!ok)throw std::runtime_error(message); }
+template<class T> struct Device {
+    T* p=nullptr;
+    explicit Device(size_t n) { check(cudaMalloc(&p,std::max(size_t(1),n)*sizeof(T))); }
+    ~Device() { cudaFree(p); }
+    void put(const std::vector<T>& v) { if(!v.empty())check(cudaMemcpy(p,v.data(),v.size()*sizeof(T),cudaMemcpyHostToDevice)); }
+    std::vector<T> get(size_t n) { std::vector<T> v(n);if(n)check(cudaMemcpy(v.data(),p,n*sizeof(T),cudaMemcpyDeviceToHost));return v; }
+};
+__global__ void query(View view,const PxU32* queries,PxU32 n,PxU32* result) {
+    const PxU32 i=blockIdx.x*blockDim.x+threadIdx.x;
+    if(i<n)result[i]=view.find(queries[i]);
+}
+void run(std::vector<Entry> values,std::vector<PxU32> queries) {
+    std::map<PxU32,PxU32> oracle;
+    for(auto e:values) { require(oracle.emplace(e.contact,e.chunk).second,"duplicate fixture identity");queries.push_back(e.contact); }
+    std::sort(values.begin(),values.end(),[](Entry a,Entry b){return a.contact<b.contact;});
+    const auto data=build(values);
+    Device<PxU32> entries(data.entries.size()),q(queries.size()),output(queries.size()+2);
+    entries.put(data.entries);q.put(queries);
+    constexpr PxU32 guard=0xabcdefab;output.put(std::vector<PxU32>(queries.size()+2,guard));
+    query<<<(queries.size()+127)/128,128>>>({data.entries.empty()?nullptr:entries.p,data.firstPage,data.pageCount},q.p,PxU32(queries.size()),output.p+1);
+    check(cudaGetLastError());check(cudaDeviceSynchronize());
+    const auto result=output.get(queries.size()+2);
+    require(result.front()==guard && result.back()==guard,"query output overwrote guards");
+    for(size_t i=0;i<queries.size();++i) {
+        const auto it=oracle.find(queries[i]);
+        require(result[i+1]==(it==oracle.end()?invalid:it->second),"GPU chunk lookup differs from independent identity oracle");
+    }
+    require(entries.get(data.entries.size())==data.entries,"query mutated persistent index");
+}
+int main() { try {
+    run({}, {0,1023,1024,invalid-1,invalid});
+    const std::vector<PxU32> boundaries={0,1,1022,1023,1024,1025,2047,2048,4096,invalid-2,invalid-1,invalid};
+    run({{1023,7},{1024,9},{2048,3}},boundaries);
+    run({{invalid-1,77}},boundaries); // High IDs alone must not allocate their entire address prefix.
+    run({{0,9},{invalid-1,10}},boundaries); // Full-width holes, absent directory pages.
+    // Replacement removes old shape mappings and can assign a recycled ID to a
+    // different authored chunk. A replacement index cannot retain a stale entry.
+    run({{1023,800},{4096,22}},boundaries);
+    for(const auto& bad:std::vector<std::vector<Entry>>{{{1,0},{1,2}},{{2,0},{1,1}},{{invalid,1}},{{1,invalid}}}) {
+        bool rejected=false;try { build(bad); } catch(const std::invalid_argument&) { rejected=true; }
+        require(rejected,"invalid mapping was accepted");
+    }
+    std::mt19937 random(413);std::vector<Entry> city;std::vector<PxU32> queries;
+    constexpr PxU32 n=113664;
+    for(PxU32 i=0;i<n;++i)city.push_back({2*i+17,(i*971)%n});
+    std::shuffle(city.begin(),city.end(),random);
+    for(PxU32 i=0;i<2*n;++i)queries.push_back(random()%(3*n));
+    run(city,queries);
+    std::puts("GPU chunk index passed: empty/sparse/full-width IDs, holes, replacement/reuse, invalid inputs and 113664 identities with 340992 queries");
+    return 0;
+} catch(const std::exception& e) { std::fprintf(stderr,"%s\n",e.what());return 1; } }
