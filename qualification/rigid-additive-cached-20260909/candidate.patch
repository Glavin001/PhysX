+// Topology-derived factors are built separately from the hot iteration kernel.
+// This keeps setup registers/stack out of every component's resident loop and
+// reuses the same exact operator factor while its generation is unchanged.
+__global__ void prepareNativeRigidCoarse(PersistentStressArgs a,ResidentStressComponentView c){
+    if(!nativeHierarchyReady(a.hierarchy))return;
+    for(unsigned slot=blockIdx.x;slot<*c.count;slot+=gridDim.x){
+        const unsigned id=c.ids[slot],begin=c.begin[id],count=c.end[id]-begin;
+        if(count<32 || count>kResidentComponentMaxNodes || !a.hierarchy.modes.components[id].anchored)continue;
+        auto& coarse=a.hierarchy.coarse[id];
+        if(coarse.valid && coarse.generation==a.hierarchy.topology->generation)continue;
+        buildNativeRigidCoarse(a,c.nodes+begin,count,id,coarse);
+        if(!threadIdx.x)coarse.generation=a.hierarchy.topology->generation;
+        __syncthreads();
+    }
+}
