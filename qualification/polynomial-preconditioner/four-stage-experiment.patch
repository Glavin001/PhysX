diff --git a/blast/source/sdk/extensions/stressgpu/detail/StressNativePolynomial.cuh b/blast/source/sdk/extensions/stressgpu/detail/StressNativePolynomial.cuh
new file mode 100644
index 00000000..8343a877
--- /dev/null
+++ b/blast/source/sdk/extensions/stressgpu/detail/StressNativePolynomial.cuh
@@ -0,0 +1,33 @@
+// Fixed four-step Chebyshev-Jacobi preconditioner for a resident component.
+// The physical matrix, convergence test and outer projected CG are unchanged.
+// If D is the node-block diagonal of L=sum_e B_e B_e^T, each edge has at most
+// two dynamic endpoints, so L <= 2D by ||u+v||^2 <= 2||u||^2+2||v||^2.
+// The interval [0.1,2.01] is a numerical preconditioner choice, not a spectral
+// cutoff: no low mode is discarded. The resulting polynomial is positive for
+// every normalized eigenvalue in [0,2]. Final nullspace projection is retained.
+// Work stays in the owning CTA; coarse-cycle scratch is reused by disjoint
+// components, and the large-component cooperative solve runs afterwards.
+__device__ __forceinline__ void preconditionNativePolynomial(
+    const PersistentStressArgs& a,const unsigned* nodes,unsigned count)
+{
+    using namespace StressHierarchy;
+    constexpr double weight[4]={
+        0.5161809957531188,5.790554046259579,0.7039959694486971,1.4502478226516293};
+    const auto input=a.hierarchy.cycle.levels[0].input;
+    auto* result=a.hierarchy.result;
+    auto* product=a.hierarchy.cycle.intermediate;
+    for(unsigned i=threadIdx.x;i<count;i+=blockDim.x){const unsigned node=nodes[i];
+        result[node]=mul(applyNativeFineInverse(a.hierarchy,node,a.hierarchy.rhs[node]),weight[0]);}
+    __syncthreads();
+#pragma unroll
+    for(unsigned step=1;step<4;++step){
+        for(unsigned i=threadIdx.x;i<count;i+=blockDim.x){const unsigned node=nodes[i];
+            product[node]=levelRowContribution(input,node,result,0,1);}
+        // All neighbor reads finish before any solution coordinate changes.
+        __syncthreads();
+        for(unsigned i=threadIdx.x;i<count;i+=blockDim.x){const unsigned node=nodes[i];
+            const auto residual=sub(a.hierarchy.rhs[node],product[node]);
+            result[node]=add(result[node],mul(applyNativeFineInverse(a.hierarchy,node,residual),weight[step]));}
+        __syncthreads();
+    }
+}
