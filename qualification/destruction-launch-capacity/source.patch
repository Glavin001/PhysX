+static void submitGpuShapeContactProperties(const PxsShapeCore& shape)
+{
+#if PX_SUPPORT_GPU_PHYSX
+    auto& physics=NpPhysics::getInstance();
+    PxMutex::ScopedLock lock(physics.getSceneAndMaterialMutex());
+    // Shared shapes have no exclusive actor. Resolve each scene registration,
+    // not every instance or contact. Execution is ordered with ordinary NP upload.
+    for(PxU32 i=0;i<physics.getNumScenes();++i)
+        physics.getScene(i)->getScScene().getSimulationController()->updateGpuShapeContactProperties(shape);
+#else
+    PX_UNUSED(shape);
+#endif
+}
