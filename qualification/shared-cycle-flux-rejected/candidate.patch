+// Included in StressHierarchyCycle.cuh inside its namespace. One exclusive
+// producer evaluates each live bond's unscaled response. Endpoint gathers use
+// exactly the original scale/sign/transpose operations after the work barrier.
+// The unscaled value avoids changing product grouping across hierarchy levels.
+template<bool CoarseCorrection,bool Local>
+__device__ __forceinline__ void cycleProduceFlux(CycleLevel d,const Vector* x,CycleWork<Local> work,const unsigned* terminalOwner,unsigned level){
+    const auto input=d.input;
+    for(unsigned index=work.threadFirst();index<work.count(input);index+=work.threadStride()){
+        const unsigned node=work.node(input,index);if(!work.enabled(input,node) || terminalOwner[input.component[node]]==level)continue;
+        for(unsigned slot=input.begin[node];slot<input.begin[node+1];++slot){
+            const unsigned ref=input.refs[slot];if(ref==Invalid)continue;
+            const unsigned edge=ref&0x7fffffffu;if(sourceHealth(input,edge)<=0)continue;
+            const unsigned first=sourceFirst(input,edge),second=sourceSecond(input,edge);
+            const bool firstDynamic=first!=Invalid && input.component[first]!=Invalid;
+            // Self edges have two references too; only the first writes.
+            if(bool(ref>>31)==firstDynamic)continue;
+            Vector a{},b{},difference{};
+            if constexpr(CoarseCorrection){
+                const auto e=d.topology.coarse[edge];if(!retainedColumn(e))continue;
+                if(e.a!=Invalid && d.child.nodeMap[e.a]!=Invalid)a=x[d.child.nodeMap[e.a]];
+                if(e.b!=Invalid && d.child.nodeMap[e.b]!=Invalid)b=x[d.child.nodeMap[e.b]];
+                if(e.a==e.b)difference={make_double3(0,0,0),cross(sub(e.offset0,e.offset1),a.angular)};
+                else difference=sub(couple(a,e.offset0),couple(b,e.offset1));
+            }else{
+                if(firstDynamic)a=couple(scaledValue(x[first],sourceInertia(input,first)),sourceOffset(input,edge,false));
+                if(second!=Invalid && input.component[second]!=Invalid)b=couple(scaledValue(x[second],sourceInertia(input,second)),sourceOffset(input,edge,true));
+                difference=sub(a,b);
+            }
+            d.flux[edge]=difference;
+        }
+    }
+}
+__device__ __forceinline__ Vector cycleCachedLevelRow(CycleLevel d,unsigned node,unsigned lane){
+    const auto input=d.input;Vector out{};
+    for(unsigned slot=input.begin[node]+lane;slot<input.begin[node+1];slot+=32){
+        const unsigned ref=input.refs[slot];if(ref==Invalid)continue;
+        const unsigned edge=ref&0x7fffffffu;if(sourceHealth(input,edge)<=0)continue;
+        const double scale=sourceScale(input,edge);const bool back=ref>>31;
+        const auto flux=mul(d.flux[edge],scale*scale*(back?-1.:1.));
+        out=add(out,scaledValue(transposeCouple(flux,sourceOffset(input,edge,back)),sourceInertia(input,node)));
+    }
+    return out;
+}
