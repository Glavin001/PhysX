diff --git a/blast/source/sdk/extensions/stressgpu/detail/StressNativeAdjacency.cuh b/blast/source/sdk/extensions/stressgpu/detail/StressNativeAdjacency.cuh
new file mode 100644
index 00000000..7fb78c85
--- /dev/null
+++ b/blast/source/sdk/extensions/stressgpu/detail/StressNativeAdjacency.cuh
@@ -0,0 +1,85 @@
+// Copyright (c) 2026. SPDX-License-Identifier: BSD-3-Clause
+// Private native topology cache. Immutable authored CSR remains the source of
+// truth: rebuilding can restore a reference if a supported topology update
+// restores its health. Only dead references are removed; live order is exact.
+#pragma once
+
+// Eight adjacent lanes cooperate on a row. This fits ordinary low-degree
+// chunk graphs while allowing unbounded-degree support rows to stream tiles.
+// Each subgroup has its own ballot mask; groups may finish independently.
+constexpr unsigned kStressAdjacencyLanes = 8;
+__global__ void countNativeStressAdjacency(const unsigned* sourceBegin,
+    const unsigned* sourceRefs,const float* health,unsigned nodes,unsigned* counts)
+{
+    const unsigned thread=blockIdx.x*blockDim.x+threadIdx.x;
+    const unsigned node=thread/kStressAdjacencyLanes,lane=thread%kStressAdjacencyLanes;
+    if(node>=nodes)return;
+    const unsigned warpBase=(threadIdx.x&31u)&~(kStressAdjacencyLanes-1u);
+    const unsigned mask=((1u<<kStressAdjacencyLanes)-1u)<<warpBase;
+    unsigned count=0;
+    for(unsigned tile=sourceBegin[node];tile<sourceBegin[node+1];tile+=kStressAdjacencyLanes){
+        const unsigned slot=tile+lane;
+        const unsigned ref=slot<sourceBegin[node+1]?sourceRefs[slot]:kDeadBondRef;
+        const bool live=ref!=kDeadBondRef && health[ref&0x7fffffffu]>0;
+        count+=__popc(__ballot_sync(mask,live));
+    }
+    if(!lane){counts[node]=count;if(!node)counts[nodes]=0;}
+}
+__global__ void scatterNativeStressAdjacency(const unsigned* sourceBegin,
+    const unsigned* sourceRefs,const float* health,unsigned nodes,
+    const unsigned* liveBegin,unsigned* liveRefs)
+{
+    const unsigned thread=blockIdx.x*blockDim.x+threadIdx.x;
+    const unsigned node=thread/kStressAdjacencyLanes,lane=thread%kStressAdjacencyLanes;
+    if(node>=nodes)return;
+    const unsigned warpBase=(threadIdx.x&31u)&~(kStressAdjacencyLanes-1u);
+    const unsigned mask=((1u<<kStressAdjacencyLanes)-1u)<<warpBase;
+    unsigned output=liveBegin[node];
+    for(unsigned tile=sourceBegin[node];tile<sourceBegin[node+1];tile+=kStressAdjacencyLanes){
+        const unsigned slot=tile+lane;
+        const unsigned ref=slot<sourceBegin[node+1]?sourceRefs[slot]:kDeadBondRef;
+        const bool live=ref!=kDeadBondRef && health[ref&0x7fffffffu]>0;
+        const unsigned votes=__ballot_sync(mask,live)>>warpBase;
+        if(live)liveRefs[output+__popc(votes&((1u<<lane)-1u))]=ref;
+        output+=__popc(votes);
+    }
+}
+class NativeStressAdjacency
+{
+    unsigned* counts=nullptr;
+    unsigned* begin=nullptr;
+    unsigned* refs=nullptr;
+    void* scratch=nullptr;
+    size_t scratchBytes=0;
+    unsigned nodes=0;
+public:
+    NativeStressAdjacency()=default;
+    NativeStressAdjacency(const NativeStressAdjacency&)=delete;
+    NativeStressAdjacency& operator=(const NativeStressAdjacency&)=delete;
+    ~NativeStressAdjacency(){cudaFree(counts);cudaFree(begin);cudaFree(refs);cudaFree(scratch);}
+    void init(unsigned nodeCount,unsigned bondCount)
+    {
+        if(!nodeCount || !bondCount || nodeCount==0xffffffffu || bondCount>0x7fffffffu)
+            throw std::runtime_error("Native stress adjacency size is invalid");
+        nodes=nodeCount;
+        checkCuda(cudaMalloc(&counts,(size_t(nodes)+1)*sizeof(unsigned)),"allocate live stress row counts");
+        checkCuda(cudaMalloc(&begin,(size_t(nodes)+1)*sizeof(unsigned)),"allocate live stress row offsets");
+        checkCuda(cudaMalloc(&refs,size_t(bondCount)*2*sizeof(unsigned)),"allocate live stress references");
+        checkCuda(cub::DeviceScan::ExclusiveSum(nullptr,scratchBytes,counts,begin,size_t(nodes)+1),"size live stress row scan");
+        checkCuda(cudaMalloc(&scratch,scratchBytes),"allocate live stress scan scratch");
+    }
+    // Capture into the generation-guarded topology transaction. No allocation,
+    // host counts or synchronization between count, scan and scatter.
+    void rebuild(const unsigned* sourceBegin,const unsigned* sourceRefs,
+        const float* health,cudaStream_t stream)
+    {
+        constexpr unsigned threads=256,nodesPerBlock=threads/kStressAdjacencyLanes;
+        const unsigned blocks=(nodes+nodesPerBlock-1)/nodesPerBlock;
+        countNativeStressAdjacency<<<blocks,threads,0,stream>>>(sourceBegin,sourceRefs,health,nodes,counts);
+        checkCuda(cub::DeviceScan::ExclusiveSum(scratch,scratchBytes,counts,begin,size_t(nodes)+1,stream),"scan live stress rows");
+        scatterNativeStressAdjacency<<<blocks,threads,0,stream>>>(sourceBegin,sourceRefs,health,nodes,begin,refs);
+        checkCuda(cudaGetLastError(),"compact live stress adjacency");
+    }
+    const unsigned* rowBegin()const{return begin;}
+    const unsigned* rowRefs()const{return refs;}
+};
diff --git a/demos/blast-stress-demo/tests/gpu_resident_adjacency_test.cu b/demos/blast-stress-demo/tests/gpu_resident_adjacency_test.cu
new file mode 100644
index 00000000..8ffa3b1e
--- /dev/null
+++ b/demos/blast-stress-demo/tests/gpu_resident_adjacency_test.cu
@@ -0,0 +1,56 @@
+// Exact stable filtering oracle, including empty/high-degree rows, health
+// changes, tombstones, restoration and repeated graph execution.
+#include <cuda_runtime.h>
+#include <cub/cub.cuh>
+#include <vector>
+#include <stdexcept>
+#include <cstdio>
+#include <cstring>
+namespace {
+constexpr unsigned kDeadBondRef=0xffffffffu;
+void checkCuda(cudaError_t e,const char* operation){if(e!=cudaSuccess)throw std::runtime_error(std::string(operation)+": "+cudaGetErrorString(e));}
+#include "detail/StressNativeAdjacency.cuh"
+template<class T>struct Buffer{
+    T* data=nullptr;
+    explicit Buffer(size_t n){checkCuda(cudaMalloc(&data,n*sizeof(T)),"test allocation");}
+    ~Buffer(){cudaFree(data);}
+    void upload(const std::vector<T>& v,cudaStream_t stream){checkCuda(cudaMemcpyAsync(data,v.data(),v.size()*sizeof(T),cudaMemcpyHostToDevice,stream),"test upload");}
+};
+void run(unsigned nodes){
+    std::vector<unsigned> starts(nodes+1),refs;
+    for(unsigned node=0;node<nodes;++node){
+        starts[node]=unsigned(refs.size());
+        const unsigned degree=node==nodes/2?4097:node%19;
+        for(unsigned j=0;j<degree;++j){const unsigned id=refs.size();refs.push_back(id%31==0?kDeadBondRef:id|((id&1)?0x80000000u:0u));}
+    }
+    starts[nodes]=refs.size();const unsigned bonds=refs.size();
+    std::vector<float> health(bonds,1);
+    Buffer<unsigned> deviceStarts(starts.size()),deviceRefs(refs.size());Buffer<float> deviceHealth(bonds);
+    cudaStream_t stream=nullptr;checkCuda(cudaStreamCreateWithFlags(&stream,cudaStreamNonBlocking),"test stream");
+    deviceStarts.upload(starts,stream);deviceRefs.upload(refs,stream);deviceHealth.upload(health,stream);
+    checkCuda(cudaStreamSynchronize(stream),"finish test input");
+    NativeStressAdjacency live;live.init(nodes,bonds);
+    cudaGraph_t graph=nullptr;cudaGraphExec_t exec=nullptr;
+    checkCuda(cudaStreamBeginCapture(stream,cudaStreamCaptureModeThreadLocal),"capture test graph");
+    live.rebuild(deviceStarts.data,deviceRefs.data,deviceHealth.data,stream);
+    checkCuda(cudaStreamEndCapture(stream,&graph),"finish test graph");checkCuda(cudaGraphInstantiate(&exec,graph,0),"instantiate test graph");
+    unsigned restored=0;
+    for(unsigned step=0;step<6;++step){
+        for(unsigned b=0;b<bonds;++b)health[b]=step==2?0.0f:step==1?(b%3?0.0f:0.25f):step==4?(b%5?1.0f:0.0f):1.0f;
+        deviceHealth.upload(health,stream);checkCuda(cudaGraphLaunch(exec,stream),"replay test graph");
+        std::vector<unsigned> expectedStarts(nodes+1),expectedRefs;
+        for(unsigned node=0;node<nodes;++node){expectedStarts[node]=expectedRefs.size();for(unsigned j=starts[node];j<starts[node+1];++j){const unsigned ref=refs[j];if(ref!=kDeadBondRef && health[ref&0x7fffffffu]>0)expectedRefs.push_back(ref);}}
+        expectedStarts[nodes]=expectedRefs.size();
+        std::vector<unsigned> actualStarts(nodes+1),actualRefs(expectedRefs.size()),unchanged(refs.size());
+        checkCuda(cudaMemcpyAsync(actualStarts.data(),live.rowBegin(),actualStarts.size()*sizeof(unsigned),cudaMemcpyDeviceToHost,stream),"read row starts");
+        if(!actualRefs.empty())checkCuda(cudaMemcpyAsync(actualRefs.data(),live.rowRefs(),actualRefs.size()*sizeof(unsigned),cudaMemcpyDeviceToHost,stream),"read live refs");
+        checkCuda(cudaMemcpyAsync(unchanged.data(),deviceRefs.data,unchanged.size()*sizeof(unsigned),cudaMemcpyDeviceToHost,stream),"read source refs");
+        checkCuda(cudaStreamSynchronize(stream),"finish test graph");
+        if(actualStarts!=expectedStarts || actualRefs!=expectedRefs || unchanged!=refs)throw std::runtime_error("stable adjacency mismatch");
+        if(step==3)restored=actualRefs.size();
+    }
+    checkCuda(cudaGraphExecDestroy(exec),"destroy test graph exec");checkCuda(cudaGraphDestroy(graph),"destroy test graph");checkCuda(cudaStreamDestroy(stream),"destroy test stream");
+    std::printf("PASS nodes=%u authored_references=%u maximum_row_degree=4097 graph_replays=6 restored_live_references=%u exact_order=true\n",nodes,bonds,restored);
+}
+}
+int main(){try{run(1);run(2051);return 0;}catch(const std::exception& e){std::fprintf(stderr,"%s\n",e.what());return 1;}}
