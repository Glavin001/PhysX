+void PxsContext::preallocateContactManagers(PxU32 count,PxsContactManager** managers)
+{
+    const PxU32 granted=mContactManagerPool.preallocate(count,managers);
+    if(mNpImplementationContext && granted)
+        mNpImplementationContext->nativeContactManagerBatch(managers,granted,false,mContactManagerPool.getSlabSize());
+}
+
+void PxsContext::releaseUnusedContactManager(PxsContactManager* manager)
+{
+    if(mNpImplementationContext)
+        mNpImplementationContext->nativeContactManagerBatch(&manager,1,true,mContactManagerPool.getSlabSize());
+    mContactManagerPool.put(manager);
+}
