+// Capture lifecycle batches at their existing serialization boundary. These
+// indices locate compatibility records; GPU allocation owns registration slots.
+void PxgGpuNarrowphaseCore::queueNativeContactRegistrations(PxsContactManager* const* managers,PxU32 count,bool retiring,PxU32 pageSize)
+{
+    if(!count || !mGpuContext || !mGpuContext->getSimulationController()->usesDeviceDestructionContactInputs())return;
+    if(!pageSize || (mRegistrationPageSize && mRegistrationPageSize!=pageSize)
+        || PxU64(mRegistrationContacts.size())+count>PX_MAX_U32) {mRegistrationInputError=true;return;}
+    mRegistrationPageSize=pageSize;
+    const PxU32 offset=mRegistrationContacts.size();
+    for(PxU32 i=0;i<count;++i) {
+        const PxU32 index=managers[i]->getIndex();
+        if(index==PX_MAX_U32){mRegistrationInputError=true;return;}
+        mRegistrationContacts.pushBack(index);
+        mRegistrationContactCapacity=PxMax(mRegistrationContactCapacity,index+1);
+    }
+    mRegistrationCommands.pushBack(retiring?PxgDestructionRegistrationCommand{offset,count,0,0}
+        :PxgDestructionRegistrationCommand{0,0,offset,count});
+}
+
+bool PxgGpuNarrowphaseCore::flushNativeContactRegistrations()
+{
+    if(mRegistrationInputError)return false;
+    if(!mRegistrationCommands.size())return true;
+    auto* runtime=mGpuContext->getSimulationController()->getNativeDestructionRuntime();
+    if(!runtime || !runtime->submitContactRegistrations(mRegistrationCommands.begin(),mRegistrationCommands.size(),
+        mRegistrationContacts.begin(),mRegistrationContacts.size(),mRegistrationContactCapacity,mRegistrationPageSize,
+        mContactGraphSequence.getTypedPtr(),mStream))return false;
+    // The NP task owns these pinned upload arrays through its completion fence.
+    mRegistrationCommands.forceSize_Unsafe(0);mRegistrationContacts.forceSize_Unsafe(0);
+    return true;
+}
