@@ -0,0 +1,62 @@
+// Immutable-graph coloring for resident block symmetric Gauss-Seidel.
+// Only lower authored IDs constrain a node's first-fit color. Every successful
+// assignment is final; later bond removals cannot invalidate a proper coloring.
+__global__ void constructNativeStressColors(StressHierarchy::Input input,unsigned* colors,unsigned* ready,unsigned* pending){
+    const auto grid=cooperative_groups::this_grid();
+    const unsigned first=blockIdx.x*blockDim.x+threadIdx.x,stride=gridDim.x*blockDim.x;
+    if(*ready)return;
+    for(unsigned node=first;node<input.nodes;node+=stride)colors[node]=kNoIsland;
+    grid.sync();
+    for(unsigned round=0;round<input.nodes;++round){
+        if(!first)*pending=0;grid.sync();
+        for(unsigned node=first;node<input.nodes;node+=stride){
+            if(input.inertia[node].y<=0 || atomicAdd(colors+node,0u)!=kNoIsland)continue;
+            bool waiting=false;
+            for(unsigned slot=input.begin[node];slot<input.begin[node+1];++slot){
+                const unsigned ref=input.refs[slot];if(ref==kNoIsland)continue;
+                const unsigned edge=ref&0x7fffffffu;if(input.health[edge]<=0)continue;
+                const unsigned other=(ref>>31)?input.node0[edge]:input.node1[edge];
+                if(other<node && input.inertia[other].y>0 && atomicAdd(colors+other,0u)==kNoIsland){waiting=true;break;}
+            }
+            if(waiting){atomicAdd(pending,1u);continue;}
+            unsigned color=0;bool occupied;
+            do{occupied=false;
+                for(unsigned slot=input.begin[node];slot<input.begin[node+1];++slot){
+                    const unsigned ref=input.refs[slot];if(ref==kNoIsland)continue;
+                    const unsigned edge=ref&0x7fffffffu;if(input.health[edge]<=0)continue;
+                    const unsigned other=(ref>>31)?input.node0[edge]:input.node1[edge];
+                    if(other<node && input.inertia[other].y>0 && atomicAdd(colors+other,0u)==color){++color;occupied=true;break;}
+                }
+            }while(occupied);
+            atomicExch(colors+node,color);
+        }
+        grid.sync();const bool finished=*pending==0;
+        // All blocks must read this round's decision before the next round
+        // resets pending. Otherwise some blocks can retire while peers enter
+        // another grid barrier, permanently stalling the cooperative launch.
+        grid.sync();if(finished){if(!first)*ready=1;return;}
+    }
+    // Lower-ID dependencies are acyclic. Failure to finish is an internal error,
+    // never an instruction to use another numerical backend.
+    if(!first)*ready=2;
+}
+class NativeStressColors {
+    StressHierarchy::Input mInput;unsigned *mColors=nullptr,*mReady=nullptr,*mPending=nullptr;unsigned mBlocks=0;
+    static void check(cudaError_t e){if(e!=cudaSuccess)throw std::runtime_error(std::string("Native stress colors: ")+cudaGetErrorString(e));}
+public:
+    NativeStressColors(StressHierarchy::Input input,cudaStream_t stream):mInput(input){
+        int device=0,sms=0,blocks=0;check(cudaGetDevice(&device));check(cudaDeviceGetAttribute(&sms,cudaDevAttrMultiProcessorCount,device));
+        check(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&blocks,constructNativeStressColors,kBlockSize,0));
+        if(blocks<=0 || sms<=0)throw std::runtime_error("Native stress coloring requires cooperative residency");
+        mBlocks=std::min(std::max(1u,(input.nodes+kBlockSize-1)/kBlockSize),unsigned(sms*blocks));
+        try{check(cudaMalloc(&mColors,std::max(1u,input.nodes)*sizeof(unsigned)));check(cudaMalloc(&mReady,sizeof(unsigned)));check(cudaMalloc(&mPending,sizeof(unsigned)));check(cudaMemsetAsync(mReady,0,sizeof(unsigned),stream));}
+        catch(...){cudaFree(mColors);cudaFree(mReady);cudaFree(mPending);throw;}
+    }
+    ~NativeStressColors(){cudaFree(mColors);cudaFree(mReady);cudaFree(mPending);}
+    cudaGraphNode_t append(cudaGraph_t graph,cudaGraphNode_t prior){
+        void* args[]={&mInput,&mColors,&mReady,&mPending};cudaKernelNodeParams p{};p.func=(void*)constructNativeStressColors;p.gridDim=dim3(mBlocks);p.blockDim=dim3(kBlockSize);p.kernelParams=args;
+        cudaGraphNode_t node;check(cudaGraphAddKernelNode(&node,graph,&prior,1,&p));cudaKernelNodeAttrValue attr{};attr.cooperative=1;check(cudaGraphKernelNodeSetAttribute(node,cudaKernelNodeAttributeCooperative,&attr));return node;
+    }
+    const unsigned* colors()const{return mColors;}
+    const unsigned* ready()const{return mReady;}
+};
