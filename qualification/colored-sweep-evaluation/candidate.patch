@@ -0,0 +1,34 @@
+// Symmetric block Gauss-Seidel: (D+U)^-1 D (D+L)^-1, where ordering is by
+// immutable graph color. Same-color nodes have no off-diagonal coupling and
+// execute concurrently. D is the existing exact cached 6x6 local operator.
+// This changes only the preconditioner; the outer physical operator, nullspace
+// projection and authoritative residual acceptance are unchanged.
+template<bool Lower>
+__device__ __forceinline__ StressHierarchy::Vector coloredNeighborSum(const PersistentStressArgs& a,unsigned node,const StressHierarchy::Vector* x,unsigned color){
+    using namespace StressHierarchy;const auto input=a.hierarchy.cycle.levels[0].input;Vector sum{};
+    for(unsigned slot=input.begin[node];slot<input.begin[node+1];++slot){
+        const unsigned ref=input.refs[slot];if(ref==Invalid)continue;
+        const unsigned edge=ref&0x7fffffffu;if(input.health[edge]<=0)continue;
+        const bool back=ref>>31;const unsigned other=back?input.node0[edge]:input.node1[edge];
+        if(other==node || input.component[other]==Invalid)continue;
+        const unsigned remoteColor=a.hierarchy.colors[other];
+        if(Lower?remoteColor>=color:remoteColor<=color)continue;
+        const auto remote=couple(scaledValue(x[other],input.inertia[other]),sourceOffset(input,edge,!back));const double scale=input.scale[edge];
+        sum=add(sum,scaledValue(transposeCouple(mul(remote,-scale*scale),sourceOffset(input,edge,back)),input.inertia[node]));
+    }
+    return sum;
+}
+__device__ __forceinline__ StressHierarchy::Vector* preconditionNativeColoredSweep(const PersistentStressArgs& a,const unsigned* nodes,unsigned count,unsigned colors){
+    using namespace StressHierarchy;auto* x=a.hierarchy.result;
+    for(unsigned color=0;color<colors;++color){
+        for(unsigned i=threadIdx.x;i<count;i+=blockDim.x){const unsigned node=nodes[i];if(a.hierarchy.colors[node]!=color)continue;
+            const auto rhs=sub(a.hierarchy.rhs[node],coloredNeighborSum<true>(a,node,x,color));x[node]=applyNativeFineInverse(a.hierarchy,node,rhs);}
+        __syncthreads();
+    }
+    for(int color=int(colors)-2;color>=0;--color){
+        for(unsigned i=threadIdx.x;i<count;i+=blockDim.x){const unsigned node=nodes[i];if(a.hierarchy.colors[node]!=unsigned(color))continue;
+            x[node]=sub(x[node],applyNativeFineInverse(a.hierarchy,node,coloredNeighborSum<false>(a,node,x,unsigned(color))));}
+        __syncthreads();
+    }
+    return x;
+}
