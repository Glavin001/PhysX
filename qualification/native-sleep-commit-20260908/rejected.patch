+// Internal sleep transaction: one kernel and one application completion
+// boundary. General-purpose public GPU setters are not part of this path.
+bool PxgSimulationCore::commitNativeSleep(CUdeviceptr indices, PxU32 count, bool rollbackPose,
+    CUdeviceptr solverDesc, CUdeviceptr solverIndices, CUevent ready)
+{
+    PxScopedCudaLock lock(*mCudaContextManager);
+    gpuDmaUpdateData();
+    if(mCudaContext->streamWaitEvent(mStream,ready)!=CUDA_SUCCESS)return false;
+    const CUdeviceptr updated=mUpdatedActorDescBuffer.getDevicePtr();
+    const CUdeviceptr previous=getBodySimPrevVelocitiesBufferDevicePtr();
+    const PxU32 shapes=getNumTotalShapes();
+    if(rollbackPose)mGpuContext->mGpuBp->getAABBManager()->setGPUStateChanged();
+    PxCudaKernelParam params[]={PX_CUDA_KERNEL_PARAM(indices),PX_CUDA_KERNEL_PARAM(count),
+        PX_CUDA_KERNEL_PARAM(rollbackPose),PX_CUDA_KERNEL_PARAM(updated),PX_CUDA_KERNEL_PARAM(solverDesc),
+        PX_CUDA_KERNEL_PARAM(solverIndices),PX_CUDA_KERNEL_PARAM(previous),PX_CUDA_KERNEL_PARAM(shapes)};
+    const CUfunction kernel=mGpuKernelWranglerManager->getCuFunction(PxgKernelIds::NATIVE_SLEEP_COMMIT);
+    if(mCudaContext->launchKernel(kernel,count,1,1,128,1,1,0,mStream,params,sizeof(params),0,PX_FL)!=CUDA_SUCCESS)return false;
+    return mCudaContext->streamSynchronize(mStream)==CUDA_SUCCESS;
+}
