@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@BLAST_ENABLE_CUDA_STRESS@)
    find_dependency(CUDAToolkit)
    include("${CMAKE_CURRENT_LIST_DIR}/../PhysXDestructionTopology/PhysXDestructionTopologyTargets.cmake")
endif()

# Native applications advance destruction through PxScene and need no Blast
# adapter or application CUDA runtime. PhysX loads its GPU module at runtime.
if(NOT TARGET PhysXDestruction::NativeScene)
    add_library(PhysXDestruction::NativeScene INTERFACE IMPORTED)
    set(_pxn_lib "${PACKAGE_PREFIX_DIR}/lib")
    set_property(TARGET PhysXDestruction::NativeScene PROPERTY INTERFACE_INCLUDE_DIRECTORIES
        "${PACKAGE_PREFIX_DIR}/include/physx")
    set_property(TARGET PhysXDestruction::NativeScene PROPERTY INTERFACE_COMPILE_DEFINITIONS
        "PX_PHYSX_STATIC_LIB;$<IF:$<CONFIG:Debug>,_DEBUG,NDEBUG>")
    set(_pxn_links "-Wl,--start-group")
    foreach(_pxn_name PhysXExtensions PhysXCudaContextManager PhysX PhysXPvdSDK PhysXCooking PhysXCommon PhysXFoundation)
        list(APPEND _pxn_links "${_pxn_lib}/lib${_pxn_name}_static_64.a")
    endforeach()
    list(APPEND _pxn_links "-Wl,--end-group" "${_pxn_lib}/libPVDRuntime_64.so" Threads::Threads ${CMAKE_DL_LIBS})
    if(TARGET CUDA::cuda_driver)
        list(APPEND _pxn_links CUDA::cuda_driver)
    else()
        list(APPEND _pxn_links cuda)
    endif()
    set_property(TARGET PhysXDestruction::NativeScene PROPERTY INTERFACE_LINK_LIBRARIES "${_pxn_links}")
    set_property(TARGET PhysXDestruction::NativeScene PROPERTY INTERFACE_LINK_OPTIONS "-Wl,-rpath,${_pxn_lib}")
    unset(_pxn_links)
    unset(_pxn_name)
    unset(_pxn_lib)
endif()

if(NOT TARGET PhysXDestruction::Sdk)
    add_library(PhysXDestruction::Sdk INTERFACE IMPORTED)
    set(_pxd_root "${PACKAGE_PREFIX_DIR}")
    set(_pxd_lib "${_pxd_root}/lib")
    set_property(TARGET PhysXDestruction::Sdk PROPERTY INTERFACE_INCLUDE_DIRECTORIES
        "${_pxd_root}/include/physx;${_pxd_root}/include/blast;${_pxd_root}/include/blast/lowlevel;${_pxd_root}/include/blast/globals;${_pxd_root}/include/blast/shared/NvFoundation;${_pxd_root}/include/blast/extensions/stress;${_pxd_root}/include/blast/extensions/stressphysx;${_pxd_root}/include/blast/extensions/stressgpu;${_pxd_root}/include/blast/ffi")
    set_property(TARGET PhysXDestruction::Sdk PROPERTY INTERFACE_COMPILE_DEFINITIONS "PX_PHYSX_STATIC_LIB;$<IF:$<CONFIG:Debug>,_DEBUG,NDEBUG>")
    set(_pxd_links "${_pxd_lib}/libNvBlastExtStressPhysX.a" "${_pxd_lib}/libblast_stress_core.a")
    if(@BLAST_ENABLE_CUDA_STRESS@)
        list(APPEND _pxd_links "${_pxd_lib}/libNvBlastExtStressGpu.a" CUDA::cudart CUDA::cuda_driver)
    endif()
    list(APPEND _pxd_links "-Wl,--start-group")
    foreach(_pxd_name PhysXExtensions PhysXCudaContextManager PhysX PhysXPvdSDK PhysXCooking PhysXCommon PhysXFoundation)
        list(APPEND _pxd_links "${_pxd_lib}/lib${_pxd_name}_static_64.a")
    endforeach()
    list(APPEND _pxd_links "-Wl,--end-group" "${_pxd_lib}/libPVDRuntime_64.so" Threads::Threads ${CMAKE_DL_LIBS})
    set_property(TARGET PhysXDestruction::Sdk PROPERTY INTERFACE_LINK_LIBRARIES "${_pxd_links}")
    set_property(TARGET PhysXDestruction::Sdk PROPERTY INTERFACE_LINK_OPTIONS "-Wl,-rpath,${_pxd_lib}")
    unset(_pxd_links)
    unset(_pxd_name)
    unset(_pxd_lib)
    unset(_pxd_root)
endif()
check_required_components(PhysXDestruction)
