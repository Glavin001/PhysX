+}catch(const std::exception& e){std::cerr<<e.what()<<'\n';return 1;}}
diff --git a/blast/source/sdk/extensions/stressgpu/test/elastic_partition_test.cu b/blast/source/sdk/extensions/stressgpu/test/elastic_partition_test.cu
