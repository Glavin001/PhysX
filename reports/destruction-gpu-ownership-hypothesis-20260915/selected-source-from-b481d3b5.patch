+    Solver s(f, { 0, 6 }, { length });
+    Device<E::Vector> low(6),solutionLow(6);
+    if(extended) {
+        check(cudaMemset(low.p,0xff,6*sizeof(E::Vector)));check(cudaMemset(solutionLow.p,0xff,6*sizeof(E::Vector)));
