+    if(!threadIdx.x)totalEnergy=denominator;__syncthreads();
+    const float alpha=totalDot/totalEnergy;
+    if(!(totalEnergy>0) || !isfinite(totalEnergy) || !isfinite(alpha) || alpha==0)return false;
